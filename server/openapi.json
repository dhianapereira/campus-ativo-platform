{
  "openapi": "3.0.0",
  "paths": {
    "/accounts": {
      "post": {
        "description": "Cria uma nova conta de usuário no sistema",
        "operationId": "CreateAccountController_handle",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateAccountRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Conta criada com sucesso" },
          "400": {
            "description": "Dados inválidos ou domínio de email não permitido"
          },
          "409": { "description": "Email já existe no sistema" }
        },
        "summary": "Criar conta",
        "tags": ["Authentication"]
      }
    },
    "/sessions": {
      "post": {
        "description": "Autentica um usuário e retorna um token JWT",
        "operationId": "AuthenticateController_handle",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthenticateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticateResponse"
                }
              }
            }
          },
          "400": { "description": "Dados inválidos" },
          "401": { "description": "Credenciais inválidas" }
        },
        "summary": "Autenticar usuário",
        "tags": ["Authentication"]
      }
    },
    "/sessions/logout": {
      "post": {
        "description": "Realiza logout do usuário (token deve ser removido no cliente)",
        "operationId": "LogoutController_handle",
        "parameters": [],
        "responses": {
          "204": { "description": "Logout realizado com sucesso" },
          "401": { "description": "Token inválido ou não fornecido" }
        },
        "summary": "Logout do usuário",
        "tags": ["Authentication"]
      }
    },
    "/profile": {
      "get": {
        "description": "Retorna as informações do perfil do usuário autenticado",
        "operationId": "GetUserProfileController_handle",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Perfil do usuário retornado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "401": { "description": "Token JWT inválido ou expirado" },
          "404": { "description": "Usuário não encontrado" }
        },
        "security": [{ "JWT-auth": [] }],
        "summary": "Obter perfil do usuário",
        "tags": ["User Profile"]
      }
    },
    "/users": {
      "get": {
        "description": "Lista todos os usuários do sistema com filtros baseados no role do usuário autenticado. ADMIN pode ver todos os usuários, DIRECTOR e abaixo não veem usuários ADMIN.",
        "operationId": "FetchUsersController_handle",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Lista de usuários retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "users": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "example": "123e4567-e89b-12d3-a456-426614174000"
                          },
                          "name": { "type": "string", "example": "João Silva" },
                          "email": {
                            "type": "string",
                            "example": "joao.silva@ifal.edu.br"
                          },
                          "position": {
                            "type": "string",
                            "example": "Técnico em Informática"
                          },
                          "role": {
                            "type": "string",
                            "enum": [
                              "REPORTER",
                              "MANAGER",
                              "DIRECTOR",
                              "ADMIN"
                            ],
                            "example": "REPORTER"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Token JWT inválido ou expirado" },
          "403": {
            "description": "Usuário não tem permissão (requer DIRECTOR+)"
          }
        },
        "security": [{ "JWT-auth": [] }],
        "summary": "Listar usuários",
        "tags": ["User Management"]
      }
    },
    "/users/{id}/role": {
      "patch": {
        "description": "Altera o role de um usuário. ADMIN pode alterar qualquer role, DIRECTOR pode alterar apenas para roles de nível igual ou inferior.",
        "operationId": "ChangeUserRoleController_handle",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID do usuário cujo role será alterado",
            "schema": {
              "example": "123e4567-e89b-12d3-a456-426614174000",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Novo role para o usuário",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": ["REPORTER", "MANAGER", "DIRECTOR", "ADMIN"],
                    "example": "MANAGER"
                  }
                },
                "required": ["role"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Role alterado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Role updated successfully"
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Dados inválidos" },
          "401": { "description": "Token JWT inválido ou expirado" },
          "403": {
            "description": "Usuário não tem permissão para esta operação"
          },
          "404": { "description": "Usuário não encontrado" }
        },
        "security": [{ "JWT-auth": [] }],
        "summary": "Alterar role do usuário",
        "tags": ["User Management"]
      }
    },
    "/problems": {
      "post": {
        "description": "Cria um novo problema de infraestrutura",
        "operationId": "CreateProblemController_handle",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateProblemRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Problema criado com sucesso" },
          "400": { "description": "Dados inválidos" },
          "401": { "description": "Token JWT inválido ou expirado" }
        },
        "security": [{ "JWT-auth": [] }],
        "summary": "Criar problema",
        "tags": ["Problems"]
      },
      "get": {
        "description": "Retorna uma lista paginada de problemas reportados no sistema",
        "operationId": "FetchProblemsController_handle",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Número da página (começa em 1)",
            "schema": { "example": 1, "type": "number" }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de problemas retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "problems": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProblemResponse"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Parâmetros inválidos" }
        },
        "summary": "Buscar problemas",
        "tags": ["Problems"]
      }
    },
    "/problems/{slug}": {
      "get": {
        "description": "Retorna um problema específico pelo seu slug",
        "operationId": "GetProblemBySlugController_handle",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "description": "Slug do problema",
            "schema": {
              "example": "ar-condicionado-nao-funcionando",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Problema encontrado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "problem": {
                      "$ref": "#/components/schemas/ProblemResponse"
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Slug inválido" },
          "404": { "description": "Problema não encontrado" }
        },
        "summary": "Buscar problema por slug",
        "tags": ["Problems"]
      }
    },
    "/categories": {
      "get": {
        "description": "Retorna uma lista paginada de categorias de problemas disponíveis no sistema",
        "operationId": "FetchCategoriesController_handle",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Número da página (começa em 1)",
            "schema": { "example": 1, "type": "number" }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de categorias retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "categories": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CategoryResponse"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Parâmetros inválidos" }
        },
        "summary": "Buscar categorias",
        "tags": ["Categories"]
      },
      "post": {
        "description": "Cria uma nova categoria de problema (requer role MANAGER+)",
        "operationId": "CreateCategoryController_handle",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateCategoryRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Categoria criada com sucesso" },
          "400": { "description": "Dados inválidos" },
          "401": { "description": "Token JWT inválido ou expirado" },
          "403": {
            "description": "Usuário não tem permissão (requer MANAGER+)"
          }
        },
        "security": [{ "JWT-auth": [] }],
        "summary": "Criar categoria",
        "tags": ["Categories"]
      }
    },
    "/locations": {
      "post": {
        "description": "Cria uma nova localização no sistema (requer role MANAGER+)",
        "operationId": "CreateLocationController_handle",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateLocationRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Localização criada com sucesso" },
          "400": { "description": "Dados inválidos" },
          "401": { "description": "Token JWT inválido ou expirado" },
          "403": {
            "description": "Usuário não tem permissão (requer MANAGER+)"
          }
        },
        "security": [{ "JWT-auth": [] }],
        "summary": "Criar localização",
        "tags": ["Locations"]
      },
      "get": {
        "description": "Retorna uma lista paginada de localizações disponíveis no sistema",
        "operationId": "FetchLocationsController_handle",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Número da página (começa em 1)",
            "schema": { "example": 1, "type": "number" }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de localizações retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "locations": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LocationResponse"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Parâmetros inválidos" }
        },
        "summary": "Buscar localizações",
        "tags": ["Locations"]
      }
    },
    "/problems/{id}": {
      "put": {
        "description": "Edita um problema existente. Apenas o criador do problema pode editá-lo.",
        "operationId": "EditProblemController_handle",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID do problema a ser editado",
            "schema": {
              "example": "123e4567-e89b-12d3-a456-426614174000",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EditProblemRequest" }
            }
          }
        },
        "responses": {
          "204": { "description": "Problema editado com sucesso" },
          "400": {
            "description": "Dados inválidos ou usuário não tem permissão"
          },
          "401": { "description": "Token JWT inválido ou expirado" },
          "404": { "description": "Problema não encontrado" }
        },
        "security": [{ "JWT-auth": [] }],
        "summary": "Editar problema",
        "tags": ["Problems"]
      },
      "delete": {
        "description": "Deleta um problema do sistema. Apenas o criador do problema pode deletá-lo.",
        "operationId": "DeleteProblemController_handle",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID do problema a ser deletado",
            "schema": {
              "example": "123e4567-e89b-12d3-a456-426614174000",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": { "description": "Problema deletado com sucesso" },
          "400": {
            "description": "Usuário não tem permissão ou problema não encontrado"
          },
          "401": { "description": "Token JWT inválido ou expirado" },
          "404": { "description": "Problema não encontrado" }
        },
        "security": [{ "JWT-auth": [] }],
        "summary": "Deletar problema",
        "tags": ["Problems"]
      }
    }
  },
  "info": {
    "title": "IFAL Arapiraca Backend API",
    "description": "API para gerenciamento de problemas de infraestrutura do IFAL Arapiraca",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "JWT",
        "description": "Enter JWT token",
        "in": "header"
      }
    },
    "schemas": {
      "CreateAccountRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome completo do usuário",
            "example": "João Silva"
          },
          "position": {
            "type": "string",
            "description": "Cargo/posição do usuário na instituição",
            "example": "Técnico em Informática"
          },
          "email": {
            "type": "string",
            "description": "Email institucional (domínios @ifal.edu.br ou @aluno.ifal.edu.br)",
            "example": "joao.silva@ifal.edu.br"
          },
          "password": {
            "type": "string",
            "description": "Senha do usuário",
            "example": "123456789",
            "minLength": 6
          }
        },
        "required": ["name", "position", "email", "password"]
      },
      "AuthenticateRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email do usuário",
            "example": "joao.silva@ifal.edu.br"
          },
          "password": {
            "type": "string",
            "description": "Senha do usuário",
            "example": "123456789"
          }
        },
        "required": ["email", "password"]
      },
      "AuthenticateResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Token JWT de acesso",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": ["access_token"]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID do usuário",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "name": {
            "type": "string",
            "description": "Nome do usuário",
            "example": "João Silva"
          },
          "email": {
            "type": "string",
            "description": "Email do usuário",
            "example": "joao.silva@ifal.edu.br"
          },
          "position": {
            "type": "string",
            "description": "Cargo/posição do usuário",
            "example": "Técnico em Informática"
          },
          "role": {
            "type": "string",
            "description": "Role do usuário",
            "enum": ["REPORTER", "MANAGER", "DIRECTOR", "ADMIN"],
            "example": "REPORTER"
          }
        },
        "required": ["id", "name", "email", "position", "role"]
      },
      "CreateProblemRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Título do problema",
            "example": "Ar condicionado não está funcionando"
          },
          "description": {
            "type": "string",
            "description": "Descrição detalhada do problema",
            "example": "O ar condicionado da sala 201 não está ligando há 3 dias"
          },
          "categoryId": {
            "type": "string",
            "description": "ID da categoria do problema",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "locationId": {
            "type": "string",
            "description": "ID da localização onde ocorreu o problema",
            "example": "123e4567-e89b-12d3-a456-426614174001"
          }
        },
        "required": ["title", "description", "categoryId", "locationId"]
      },
      "CreateCategoryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome da categoria",
            "example": "Climatização"
          },
          "description": {
            "type": "string",
            "description": "Descrição da categoria",
            "example": "Problemas relacionados a ar condicionado, ventilação e climatização"
          }
        },
        "required": ["name", "description"]
      },
      "CreateLocationRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome da localização",
            "example": "Bloco A - Sala 201"
          },
          "description": {
            "type": "string",
            "description": "Descrição da localização",
            "example": "Sala de aula localizada no primeiro andar do Bloco A"
          },
          "code": {
            "type": "string",
            "description": "Código identificador da localização",
            "example": "BLA-201"
          }
        },
        "required": ["name", "description", "code"]
      },
      "EditProblemRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Novo título do problema",
            "example": "Ar condicionado com defeito na sala 201"
          },
          "description": {
            "type": "string",
            "description": "Nova descrição do problema",
            "example": "O ar condicionado da sala 201 está fazendo ruído estranho e não resfriando adequadamente"
          }
        },
        "required": ["title", "description"]
      }
    }
  }
}
